# Keep source and documentation readable across operating systems.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cff text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

# Binary artifacts must never receive line-ending conversion.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.parquet binary
*.pkl binary
*.joblib binary
